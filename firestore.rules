rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Teacher dashboard allowlist — Google account emails allowed to read
    // every student's profile + progress. Keep in sync with the client-side
    // list in src/scripts/teacher-config.js (that copy is UI-only; this is
    // the actual enforcement).
    function isTeacher() {
      return request.auth != null &&
        request.auth.token.email in ['gasyoun@gmail.com'];
    }

    function isCloudSyncDoc(docId) {
      return docId in ['srs_v1', 'telemetry', 'progress_meta'];
    }

    function hasCloudSyncShape() {
      return request.resource.data.keys().hasAll(['payload', 'updated_at'])
        && request.resource.data.keys().hasOnly(['payload', 'updated_at'])
        && request.resource.data.updated_at is string;
    }

    function hasProfileShape() {
      return request.resource.data.keys().hasAll(['email', 'updated_at'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'updated_at'])
        && request.resource.data.updated_at is string;
    }

    // Public leaderboard row: aggregated stats ONLY (name, mastered count,
    // streak days). Public read so every student can see the board without
    // gaining access to anyone's private SRS docs; each student writes only
    // their own row.
    function hasLeaderboardShape() {
      return request.resource.data.keys().hasAll(['displayName', 'mastered_count', 'streak_days', 'updated_at'])
        && request.resource.data.keys().hasOnly(['displayName', 'mastered_count', 'streak_days', 'updated_at'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.mastered_count is number
        && request.resource.data.mastered_count >= 0
        && request.resource.data.streak_days is number
        && request.resource.data.streak_days >= 0
        && request.resource.data.updated_at is string;
    }

    // Groups (H8416, MG ruling 18-11-2026) — teacher-managed cohort docs.
    // Doc: groups/{groupId} = { name, members: [uid...], updated_at }. The
    // members list IS the membership wiring: a signed-in student may read
    // only groups they belong to, so the group-scoped board (follow-up UI
    // unit) filters the already-public leaderboard rows by that member list
    // client-side. Writes are teacher-only; deletes stay closed. Global
    // leaderboard/{uid} behaviour is untouched — still publicly readable,
    // owner-writable, exact 4-key shape.
    function hasGroupShape() {
      return request.resource.data.keys().hasAll(['name', 'members', 'updated_at'])
        && request.resource.data.keys().hasOnly(['name', 'members', 'updated_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 500
        && request.resource.data.updated_at is string;
    }

    function isGroupMember() {
      return request.auth != null && request.auth.uid in resource.data.members;
    }

    // Top-level per-student profile (email/displayName) — lets a teacher
    // enumerate students via collection(db, 'users'); the per-datatype SRS
    // documents stay nested below.
    match /users/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create, update: if isOwner(uid) && hasProfileShape();
      allow delete: if false;
    }

    match /users/{uid}/data/{docId} {
      allow read: if (isOwner(uid) || isTeacher()) && isCloudSyncDoc(docId);
      allow create, update: if isOwner(uid) && isCloudSyncDoc(docId) && hasCloudSyncShape();
      allow delete: if false;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && hasLeaderboardShape();
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isTeacher() || isGroupMember();
      allow create, update: if isTeacher() && hasGroupShape();
      allow delete: if false;
    }
  }
}
